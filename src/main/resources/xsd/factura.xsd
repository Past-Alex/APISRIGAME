<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- ===========================================================
           XSD FACTURA ELECTRÓNICA  SRI - VERSIÓN 1.1.0
         =========================================================== -->

    <xs:element name="factura">
        <xs:complexType>
            <xs:sequence>

                <!-- ===========================
                     1) INFO TRIBUTARIA
                ============================ -->
                <xs:element name="infoTributaria">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="ambiente" type="xs:integer"/>
                            <xs:element name="tipoEmision" type="xs:integer"/>
                            <xs:element name="razonSocial" type="xs:string"/>
                            <xs:element name="nombreComercial" type="xs:string" minOccurs="0"/>
                            <xs:element name="ruc" type="xs:string"/>
                            <xs:element name="claveAcceso" type="xs:string"/>
                            <xs:element name="codDoc" type="xs:string"/>
                            <xs:element name="estab" type="xs:string"/>
                            <xs:element name="ptoEmi" type="xs:string"/>
                            <xs:element name="secuencial" type="xs:string"/>
                            <xs:element name="dirMatriz" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- ===========================
                     2) INFO FACTURA
                ============================ -->
                <xs:element name="infoFactura">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="fechaEmision" type="xs:string"/>
                            <xs:element name="dirEstablecimiento" type="xs:string"/>
                            <xs:element name="obligadoContabilidad" type="xs:string" minOccurs="0"/>
                            <xs:element name="tipoIdentificacionComprador" type="xs:string"/>
                            <xs:element name="razonSocialComprador" type="xs:string"/>
                            <xs:element name="identificacionComprador" type="xs:string"/>
                            <xs:element name="direccionComprador" type="xs:string"/>
                            <xs:element name="totalSinImpuestos" type="xs:decimal"/>
                            <xs:element name="totalDescuento" type="xs:decimal"/>

                            <!-- impuestos totales -->
                            <xs:element name="totalConImpuestos">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="totalImpuesto" maxOccurs="10">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="codigo" type="xs:string"/>
                                                    <xs:element name="codigoPorcentaje" type="xs:string"/>
                                                    <xs:element name="baseImponible" type="xs:decimal"/>
                                                    <xs:element name="valor" type="xs:decimal"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                            <xs:element name="propina" type="xs:decimal" default="0.00"/>
                            <xs:element name="importeTotal" type="xs:decimal"/>
                            <xs:element name="moneda" type="xs:string" default="DOLAR"/>

                            <!-- métodos de pago -->
                            <xs:element name="pagos">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="pago" maxOccurs="10">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="formaPago" type="xs:string"/>
                                                    <xs:element name="total" type="xs:decimal"/>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>

                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- ===========================
                     3) DETALLES FACTURA
                ============================ -->
                <xs:element name="detalles">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="detalle" maxOccurs="2000">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="codigoPrincipal" type="xs:string"/>
                                        <xs:element name="codigoAuxiliar" type="xs:string" minOccurs="0"/>
                                        <xs:element name="descripcion" type="xs:string"/>
                                        <xs:element name="cantidad" type="xs:decimal"/>
                                        <xs:element name="precioUnitario" type="xs:decimal"/>
                                        <xs:element name="descuento" type="xs:decimal"/>
                                        <xs:element name="precioTotalSinImpuesto" type="xs:decimal"/>

                                        <xs:element name="impuestos">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="impuesto" maxOccurs="10">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="codigo" type="xs:string"/>
                                                                <xs:element name="codigoPorcentaje" type="xs:string"/>
                                                                <xs:element name="tarifa" type="xs:decimal"/>
                                                                <xs:element name="baseImponible" type="xs:decimal"/>
                                                                <xs:element name="valor" type="xs:decimal"/>
                                                            </xs:sequence>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>

                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <!-- ===========================
                     4) INFO ADICIONAL OPCIONAL
                ============================ -->
                <xs:element name="infoAdicional" minOccurs="0">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="campoAdicional" maxOccurs="50">
                                <xs:complexType mixed="true">
                                    <xs:attribute name="nombre" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>

            <xs:attribute name="version" type="xs:string" fixed="1.1.0"/>
            <xs:attribute name="id" type="xs:string"/>

        </xs:complexType>
    </xs:element>

</xs:schema>
